# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public HTTPS base URL this app is reachable at (used to verify Twilio signatures)
PUBLIC_BASE_URL=https://your-app.example.com

# Secret for the /admin endpoints (make it long and random)
ADMIN_TOKEN=

# Where the SQLite database lives
DATABASE_PATH=leadback.db

# Set to "false" only for local testing without Twilio
VALIDATE_TWILIO_SIGNATURE=true
